---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const clusterLabel = {
  km: 'Knowledge Management and AI',
  agents: 'Agent to Agent',
  education: 'AI and Education',
}[project.data.cluster];

const record = [
  { label: 'Idea', value: project.data.idea },
  { label: 'Research Question', value: project.data.researchQuestion },
  { label: 'Key Proposition', value: project.data.keyProposition },
  { label: 'Data', value: project.data.dataDescription },
  { label: 'Analysis Result', value: project.data.findings },
].filter((f) => f.value);
---
<Base title={`${project.data.title} · Social Intelligence & AI Lab`}>
  <article class="max-w-3xl mx-auto px-6 pt-24 pb-20">
    <p class="text-xs uppercase tracking-widest text-accent mb-4">
      <a href={`${base}/research`} class="hover:!text-ink">{clusterLabel}</a>
      {project.data.area && <span class="text-muted"> &middot; {project.data.area}</span>}
    </p>
    <h1 class="font-display text-4xl md:text-5xl leading-tight">{project.data.title}</h1>
    <p class="mt-6 text-lg text-muted leading-relaxed">{project.data.oneLine}</p>

    <div class="mt-10 bg-warm rounded-soft p-6">
      <dl class="grid grid-cols-2 gap-y-4 text-sm">
        <dt class="text-muted uppercase tracking-wider text-xs">Stage</dt>
        <dd>{project.data.stage}</dd>
        {project.data.lastActivity && (
          <>
            <dt class="text-muted uppercase tracking-wider text-xs">Last activity</dt>
            <dd>{project.data.lastActivity}</dd>
          </>
        )}
        {project.data.venue && (
          <>
            <dt class="text-muted uppercase tracking-wider text-xs">Target venue</dt>
            <dd>{project.data.venue}</dd>
          </>
        )}
        {project.data.collaborators && project.data.collaborators.length > 0 && (
          <>
            <dt class="text-muted uppercase tracking-wider text-xs">Collaborators</dt>
            <dd>{project.data.collaborators.join(', ')}</dd>
          </>
        )}
      </dl>
    </div>

    <div class="mt-12 text-base leading-relaxed text-ink/85">
      <Content />
    </div>

    {record.length > 0 && (
      <section class="mt-14 border-t border-rule pt-10">
        <h2 class="font-display text-2xl mb-8">The record</h2>
        <dl class="space-y-8">
          {record.map((f) => (
            <div>
              <dt class="text-xs uppercase tracking-widest text-accent mb-2">{f.label}</dt>
              <dd class="text-base leading-relaxed text-ink/85">{f.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <p class="mt-16 text-sm">
      <a href={`${base}/research`}>&larr; All research</a>
    </p>
  </article>
</Base>
