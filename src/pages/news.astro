---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="News · Social Intelligence & AI Lab">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-10">
    <p class="text-xs uppercase tracking-widest text-accent mb-4">News</p>
    <h1 class="font-display text-4xl md:text-5xl">News &amp; updates</h1>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-10">
    <ul class="space-y-8">
      {news.map(async (n) => {
        const { Content } = await n.render();
        return (
          <li class="bg-warm rounded-soft p-7">
            <time class="text-xs uppercase tracking-widest text-accent">
              {n.data.date.toISOString().slice(0, 10)}
            </time>
            <h2 class="font-display text-xl mt-2">{n.data.title}</h2>
            <div class="news-body mt-3 text-sm text-muted leading-relaxed">
              <Content />
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style is:global>
  .news-body > * + * { margin-top: 0.85rem; }
  .news-body p strong { color: #2c2420; font-weight: 600; }
  .news-body h3 {
    margin-top: 1.6rem;
    font-size: 1.05rem;
    color: #2c2420;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #e8e0d6;
  }
  .news-body ul { list-style: none; padding-left: 0; }
  .news-body ul > li {
    position: relative;
    padding-left: 1.25rem;
    margin-top: 0.45rem;
  }
  .news-body ul > li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 9999px;
    background: #b56a3a;
  }
  .news-body li strong { color: #2c2420; font-weight: 600; }
</style>
