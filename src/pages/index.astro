---
import Base from '../layouts/Base.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import ThreadIcon from '../components/ThreadIcon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-8">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div>
        <h1 class="font-display text-5xl md:text-6xl leading-[1.05] max-w-xl">
          We study social<br />intelligence in&nbsp;AI.
        </h1>
        <p class="mt-8 max-w-prose text-lg text-muted leading-relaxed">
          How do artificial agents perceive, express, and calibrate social behavior?
          We pursue these questions through the lens of empathy, care, and what it means
          to be present for another &mdash; human or otherwise.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={`${base}/research`}
            class="inline-flex items-center gap-2 bg-accent !text-paper px-6 py-3 rounded-soft text-sm font-medium hover:shadow-hover hover:-translate-y-0.5">
            Our research &rarr;
          </a>
          <a href={`${base}/people`}
            class="inline-flex items-center gap-2 bg-warm !text-ink px-6 py-3 rounded-soft text-sm font-medium hover:shadow-hover hover:-translate-y-0.5">
            Meet the team
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <HeroGraphic />
      </div>
    </div>
  </section>

  <!-- Gentle divider -->
  <div class="max-w-5xl mx-auto px-6 py-8">
    <svg viewBox="0 0 1000 40" fill="none" class="w-full h-8 opacity-30" aria-hidden="true">
      <path d="M 0 20 Q 250 5, 500 20 T 1000 20" stroke="#b56a3a" stroke-width="0.8" fill="none" />
    </svg>
  </div>

  <!-- Three threads -->
  <section class="bg-warm py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-widest text-accent mb-4">What we do</p>
      <h2 class="font-display text-3xl md:text-4xl mb-14">Three threads, one question.</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <a href={`${base}/research`} class="group bg-paper p-8 rounded-soft shadow-gentle hover:shadow-hover hover:-translate-y-1 no-underline block text-center">
          <div class="flex justify-center">
            <ThreadIcon thread="empathy" />
          </div>
          <h3 class="font-display text-xl mb-3 !text-ink group-hover:!text-accent">Empathy &amp; LLMs</h3>
          <p class="text-sm text-muted leading-relaxed">
            When and how should language models express, recognize, or withhold empathy?
            We build frameworks, taxonomies, and evaluation protocols grounded in care.
          </p>
        </a>
        <a href={`${base}/research`} class="group bg-paper p-8 rounded-soft shadow-gentle hover:shadow-hover hover:-translate-y-1 no-underline block text-center">
          <div class="flex justify-center">
            <ThreadIcon thread="agents" />
          </div>
          <h3 class="font-display text-xl mb-3 !text-ink group-hover:!text-accent">Multi-Agent Coordination</h3>
          <p class="text-sm text-muted leading-relaxed">
            How do agents select, trust, and care for one another in open ecosystems?
            We develop theories of coordination as a form of mutual support.
          </p>
        </a>
        <a href={`${base}/research`} class="group bg-paper p-8 rounded-soft shadow-gentle hover:shadow-hover hover:-translate-y-1 no-underline block text-center">
          <div class="flex justify-center">
            <ThreadIcon thread="society" />
          </div>
          <h3 class="font-display text-xl mb-3 !text-ink group-hover:!text-accent">AI &amp; Society</h3>
          <p class="text-sm text-muted leading-relaxed">
            How is AI reshaping the way people help each other?
            We study how care and knowledge-sharing survive technological change.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Recent news -->
  {news.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-accent mb-4">Latest</p>
      <h2 class="font-display text-3xl mb-10">Recent news</h2>
      <ul class="space-y-6">
        {news.map((n) => (
          <li class="flex gap-6 items-start">
            <time class="text-xs text-muted w-28 shrink-0 pt-1 uppercase tracking-wider">
              {n.data.date.toISOString().slice(0, 10)}
            </time>
            <div class="border-l-2 border-accent/40 pl-5">
              <p class="text-base">{n.data.title}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
