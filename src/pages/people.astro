---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoUrl = (p: string) => (p.startsWith('http') ? p : `${base}${p}`);
---
<Base title="People · Social Intelligence & AI Lab">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-10">
    <p class="text-xs uppercase tracking-widest text-accent mb-4">People</p>
    <h1 class="font-display text-4xl md:text-5xl">Who we are</h1>
    <p class="mt-6 max-w-prose text-muted leading-relaxed">
      A small, focused group exploring what it means for AI to act with social intelligence.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10">
    <ul class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {people.map((person) => (
        <li class="bg-warm rounded-soft p-5 flex flex-col items-center text-center hover:shadow-hover hover:-translate-y-1">
          {person.data.photo ? (
            <img
              src={photoUrl(person.data.photo)}
              alt={person.data.name}
              class="w-20 h-20 rounded-full object-cover mb-3"
              loading="lazy"
            />
          ) : (
            <div class="w-20 h-20 rounded-full bg-paper flex items-center justify-center text-muted text-xl mb-3">
              {person.data.name.charAt(0)}
            </div>
          )}
          <h2 class="font-display text-base leading-tight">{person.data.name}</h2>
          <p class="mt-2 text-xs">
            <a href={person.data.website} target="_blank" rel="noopener noreferrer">Website &rarr;</a>
          </p>
        </li>
      ))}
    </ul>
  </section>
</Base>
