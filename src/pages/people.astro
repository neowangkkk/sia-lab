---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="People · Social Intelligence & AI Lab">
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-10">
    <p class="text-xs uppercase tracking-widest text-accent mb-4">People</p>
    <h1 class="font-display text-4xl md:text-5xl">Who we are</h1>
    <p class="mt-6 max-w-prose text-muted leading-relaxed">
      A small, focused group exploring what it means for AI to act with social intelligence.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10">
    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-8">
      {people.map(async (person) => {
        const { Content } = await person.render();
        return (
          <li class="bg-warm rounded-soft p-6 hover:shadow-hover hover:-translate-y-1">
            <div class="aspect-square bg-paper rounded-soft mb-5 flex items-center justify-center text-muted text-xs uppercase tracking-widest overflow-hidden">
              {person.data.photo ? (
                <img src={person.data.photo} alt={person.data.name} class="w-full h-full object-cover" />
              ) : (
                <span class="text-3xl">&#128100;</span>
              )}
            </div>
            <h2 class="font-display text-lg">{person.data.name}</h2>
            <p class="text-sm text-accent">{person.data.role}</p>
            {person.data.affiliation && (
              <p class="text-xs text-muted mt-1">{person.data.affiliation}</p>
            )}
            <div class="mt-3 text-sm text-muted leading-relaxed">
              <Content />
            </div>
            {person.data.links && (
              <p class="text-xs mt-3 flex gap-3">
                {person.data.links.scholar && <a href={person.data.links.scholar}>Scholar</a>}
                {person.data.links.github && <a href={person.data.links.github}>GitHub</a>}
                {person.data.links.website && <a href={person.data.links.website}>Website</a>}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</Base>
