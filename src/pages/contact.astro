---
import Base from '../layouts/Base.astro';
---
<Base title="Contact · Social Intelligence & AI Lab">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-24">
    <p class="text-xs uppercase tracking-widest text-accent mb-4">Contact</p>
    <h1 class="font-display text-4xl md:text-5xl">Get in touch</h1>

    <div class="mt-12 space-y-8">
      <div class="bg-warm rounded-soft p-7">
        <p class="text-xs uppercase tracking-widest text-accent mb-3">General inquiries</p>
        <p class="font-display text-lg">
          <a href="mailto:hello@sialab.org" class="hover:text-accent transition-colors">hello@sialab.org</a>
        </p>
        <p class="text-muted text-sm mt-2">For collaborations, press, and prospective students.</p>
      </div>

      <div class="bg-warm rounded-soft p-7">
        <p class="text-xs uppercase tracking-widest text-accent mb-3">Address</p>
        <p>Faculty of Information</p>
        <p>University of Toronto</p>
        <p>140 St George Street, Toronto, ON M5S 3G6</p>
      </div>

      <div class="bg-warm rounded-soft p-7">
        <p class="text-xs uppercase tracking-widest text-accent mb-3">Prospective students</p>
        <p class="text-muted leading-relaxed">
          We welcome inquiries from students interested in empathy in AI, multi-agent coordination,
          or the social impacts of AI systems. Please include your CV, a brief statement of
          interest, and (for PhD applicants) a writing sample.
        </p>
      </div>
    </div>
  </section>
</Base>
