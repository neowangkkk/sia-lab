---
interface Props {
  thread: 'km' | 'agents' | 'education';
}
const { thread } = Astro.props;
---
{thread === 'km' && (
  <!-- Concentric ripples — knowledge accumulating outward -->
  <svg viewBox="0 0 80 80" fill="none" class="w-16 h-16 mb-4" aria-hidden="true">
    <circle cx="40" cy="40" r="8" fill="#b56a3a" opacity="0.2" />
    <circle cx="40" cy="40" r="16" stroke="#b56a3a" stroke-width="1" opacity="0.2" />
    <circle cx="40" cy="40" r="24" stroke="#d4856a" stroke-width="0.8" opacity="0.15" />
    <circle cx="40" cy="40" r="32" stroke="#e8a87c" stroke-width="0.6" opacity="0.1" />
  </svg>
)}

{thread === 'agents' && (
  <!-- Reaching tendrils — coordination -->
  <svg viewBox="0 0 80 80" fill="none" class="w-16 h-16 mb-4" aria-hidden="true">
    <defs>
      <linearGradient id="ic-agents" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#d4856a" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#b56a3a" stop-opacity="0.15" />
      </linearGradient>
    </defs>
    <circle cx="20" cy="40" r="10" fill="url(#ic-agents)" />
    <circle cx="60" cy="40" r="10" fill="url(#ic-agents)" />
    <path d="M 30 38 Q 40 30, 50 38" stroke="#b56a3a" stroke-width="1.5" opacity="0.3" fill="none" />
    <path d="M 30 42 Q 40 50, 50 42" stroke="#d4856a" stroke-width="1.5" opacity="0.25" fill="none" />
    <circle cx="40" cy="40" r="4" fill="#b56a3a" opacity="0.15" />
  </svg>
)}

{thread === 'education' && (
  <!-- Two forms leaning into each other — teaching -->
  <svg viewBox="0 0 80 80" fill="none" class="w-16 h-16 mb-4" aria-hidden="true">
    <defs>
      <linearGradient id="ic-education" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#b56a3a" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#e8a87c" stop-opacity="0.2" />
      </linearGradient>
    </defs>
    <ellipse cx="30" cy="42" rx="18" ry="22" fill="url(#ic-education)" transform="rotate(-10 30 42)" />
    <ellipse cx="50" cy="42" rx="18" ry="22" fill="url(#ic-education)" transform="rotate(10 50 42)" />
    <ellipse cx="40" cy="44" rx="10" ry="14" fill="#b56a3a" opacity="0.12" />
  </svg>
)}
