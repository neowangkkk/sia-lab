---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-warm mt-24">
  <div class="max-w-5xl mx-auto px-6 py-14 text-sm text-muted">
    <div class="flex flex-wrap justify-between gap-8 mb-10">
      <div>
        <p class="font-display text-lg text-ink mb-3">Social Intelligence &amp; AI Lab</p>
        <p>School of Information</p>
        <p>University of Toronto</p>
      </div>
      <div class="flex gap-8 text-xs">
        <div>
          <p class="uppercase tracking-widest text-ink mb-2">Navigate</p>
          <ul class="space-y-1.5">
            <li><a href={`${base}/research`}>Research</a></li>
            <li><a href={`${base}/projects`}>Projects</a></li>
            <li><a href={`${base}/people`}>People</a></li>
          </ul>
        </div>
        <div>
          <p class="uppercase tracking-widest text-ink mb-2">Connect</p>
          <ul class="space-y-1.5">
            <li><a href={`${base}/publications`}>Publications</a></li>
            <li><a href={`${base}/news`}>News</a></li>
            <li><a href={`${base}/contact`}>Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="border-t border-rule pt-6 flex flex-wrap justify-between gap-4 text-xs text-muted">
      <p>&copy; {year} SIA Lab &middot; University of Toronto</p>
      <p>Built with care and Astro.</p>
    </div>
  </div>
</footer>
