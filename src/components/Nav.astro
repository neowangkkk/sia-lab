---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/research`, label: 'Research' },
  { href: `${base}/people`, label: 'People' },
  { href: `${base}/publications`, label: 'Publications' },
  { href: `${base}/news`, label: 'News' },
  { href: `${base}/contact`, label: 'Contact' },
];
---
<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-6 py-5 flex flex-wrap items-baseline justify-between gap-4">
    <a href={`${base}/`} class="font-display text-lg tracking-tight !text-ink hover:!text-accent">
      SIA Lab
    </a>
    <nav>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="!text-muted hover:!text-ink relative after:absolute after:bottom-[-2px] after:left-0 after:w-0 after:h-[1.5px] after:bg-accent after:transition-all after:duration-300 hover:after:w-full"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
